PORT=3000
# Dokploy: bu konumu kalıcı bir volume'a bağla.
ACCOUNT_DATA_DIR=/app/.data
# İnternetten multiplayer katılımında hesap zorunlu olsun.
REQUIRE_LOGIN=true
# Yalnızca güvenilir reverse proxy arkasında true kullan.
TRUST_PROXY=true
# Gerçek domainin; localhost geliştirmede bu alanı boş bırak.
PUBLIC_ORIGIN=https://oyun.example.com
